modules = ["python-base-3.13", "nodejs-24", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Site preview"

[[workflows.workflow]]
name = "Site preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python no_cache_server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[deployment]
deploymentTarget = "static"
publicDir = "."

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
