modules = ["python-base-3.13", "nodejs-24"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Static site"

[[workflows.workflow]]
name = "Static site"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python no_cache_server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
